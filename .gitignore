# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
*.apk
*.aab
/android/app/debug
/android/app/profile
/android/app/release

# Firma privada de Android
/android/key.properties
*.jks
*.keystore
/mcps/
/terminals/
**/.env
**/.env.*
!**/.env.example
**/*.local.php
**/*.local.json
/server/storage/
/android/build/
/android/.kotlin/
__pycache__/

/dist/

# Dispositivo Android de pruebas, solo local
/.android/

# Evidencias locales de verificación: registros, capturas y copias de la web.
# Se conservan en el equipo de desarrollo, no en el repositorio.
/docs/yoma/*.txt
/docs/yoma/*.log
/docs/yoma/*.json
/docs/yoma/*.xml
/docs/yoma/*.png
!/docs/yoma/selector.png
/docs/yoma/deployment/
/docs/yoma/physical/
/docs/yoma/qa-download-diagnostic/
/docs/yoma/source-audit/*
!/docs/yoma/source-audit/catalog.json
!/docs/yoma/source-audit/detail.json

# Web de Yoma: nunca credenciales ni datos generados por el servidor.
web/**/private/*.local.php
web/tv.yoma.site/data/
web/tv.yoma.site/feeds/
web/tv.yoma.site/downloads/
web/tv.yoma.site/releases/*/data/
web/tv.yoma.site/releases/*/feeds/
web/tv.yoma.site/releases/*/downloads/
